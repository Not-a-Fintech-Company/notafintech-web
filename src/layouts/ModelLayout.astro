---
// src/layouts/ModelLayout.astro
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/nav/Breadcrumbs.astro';
import Prose from '../components/ui/Prose.astro';
import { articleSchema, type Author } from '../lib/article-schema';

interface Props {
  title: string;
  description: string;
  section?: string;
  ogImage?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  authors?: Author[];
}
const { title, description, section, ogImage, publishedAt, updatedAt, authors } = Astro.props;

const sectionLabel = section ? section.charAt(0).toUpperCase() + section.slice(1) : null;
const crumbs = [
  { label: 'Home', href: '/' },
  ...(section ? [{ label: sectionLabel!, href: `/${section}/` }] : []),
  { label: title },
];

const schema = articleSchema({
  title, description, site: Astro.site!, pathname: Astro.url.pathname,
  ogImage, publishedAt, updatedAt, authors,
});
---

<BaseLayout
  {title}
  {description}
  {ogImage}
  pageType={schema ? 'article' : undefined}
  publishedTime={publishedAt}
  modifiedTime={updatedAt ?? publishedAt}
  {schema}
>
  <Header />
  <MobileMenu />

  <main id="main" class="flex-1 max-w-6xl w-full mx-auto px-4 md:px-6 py-8 md:py-12">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4 font-display text-4xl md:text-6xl font-bold tracking-[-0.025em] text-ink leading-[1.05]">
      {title}
    </h1>
    {description && (
      <p class="mt-5 text-lg text-ink/80 max-w-prose leading-relaxed">{description}</p>
    )}

    <div class="mt-10">
      <Prose>
        <slot />
      </Prose>
    </div>
  </main>

  <Footer />
</BaseLayout>
